__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv
/api_keys.env
multirun/
artifacts/
.cache/
archive/

# Run artifacts -------------------------------------------------------------
# Adapters and checkpoints are ~20 GB and fully regenerable from the code plus
# the prompt library; the evidence needed to check the findings (metrics,
# training curves, and the sampled rollouts the metric definitions were
# validated on) is ~7.5 MB and is kept.
outputs/**
!outputs/
!outputs/political/
!outputs/political/*/
!outputs/political/macron_broad.json
!outputs/political/*/report.json
!outputs/political/*/train_history.json
!outputs/political/*/bias_stats.json
!outputs/political/*/samples.jsonl
!outputs/political/*/VOID.md

# Generalization study: same policy -- metrics and sampled rollouts are the
# evidence and are kept; adapters are regenerable and are not.
!outputs/generalization/
!outputs/generalization/*/
!outputs/generalization/*/*/
!outputs/generalization/*/*/report.json
!outputs/generalization/*/*/gate.json
!outputs/generalization/*/*/narrow_completions.jsonl
!outputs/generalization/*/*/gate_narrow_completions.jsonl
outputs/generalization/*/*/debias_adapter/
outputs/generalization/*/*/adapter/

# Never: LoRA weights, quantised bases, tokenizer copies.
outputs/political/*/bias/
outputs/political/*/unbias_adapter/
outputs/political/*/adapter/
*.safetensors
*.bin
*.pt

# Worktree convenience symlinks — never commit these as links.
/outputs
/artifacts
